# Use Node.js 18 Alpine as base image
FROM node:18-alpine AS base

# Install dependencies only when needed
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Install dependencies based on the preferred package manager
COPY package.json package-lock.json* ./
RUN npm ci

# Build the socket server
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package*.json ./
COPY src/lib/realtime-server.ts ./src/lib/
COPY src/lib/db.ts ./src/lib/
COPY src/lib/socket-server.ts ./

# Build TypeScript
RUN npm install -g typescript ts-node
RUN npx tsc src/lib/socket-server.ts --outDir ./dist --target es2020 --module commonjs --esModuleInterop

# Production image
FROM base AS runner
WORKDIR /app

ENV NODE_ENV production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 socket

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/src/lib ./src/lib

USER socket

EXPOSE 3001

CMD ["node", "dist/socket-server.js"]